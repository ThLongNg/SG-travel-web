---
// VND ⇄ JPY converter. Runs entirely in the browser; the rate and its date come from rate.config.ts.
import GlassPanel from '../glass/GlassPanel.astro';
import GlassChip from '../glass/GlassChip.astro';
import GlassButton from '../glass/GlassButton.astro';
import { rate } from './rate.config';
import { formatJaDate } from '../../lib/format';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const initialVnd = 100000;
const quick = [10000, 50000, 100000, 200000, 500000];
const yenPer = (n: number) => Math.round(n * rate.jpyPerVnd).toLocaleString('ja-JP');
const sourceKnown = !rate.source.startsWith('TODO');
---

<GlassPanel padding="md" data-converter data-rate={rate.jpyPerVnd}>
  <form class="flex flex-col gap-2" data-cv-fields>
    <div class="cv-field" data-cv-row="vnd">
      <label for="cv-vnd" class="text-[12px] font-semibold text-ink-muted">
        {t(lang, 'guide.vnd')}
      </label>
      <div class="glass glass--light glass-pill flex items-center gap-2 px-5">
        <input
          id="cv-vnd"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          value={initialVnd.toLocaleString('ja-JP')}
          class="font-latin min-h-[52px] min-w-0 flex-1 bg-transparent text-[24px] font-semibold text-ink outline-none"
        />
        <span class="font-latin text-[15px] text-ink-muted" aria-hidden="true">
          ₫
        </span>
      </div>
    </div>
    <div class="flex justify-center">
      <GlassButton
        iconOnly
        icon="swap"
        label={t(lang, 'guide.swap')}
        class="rotate-90"
        data-cv-swap
      />
    </div>
    <div class="cv-field" data-cv-row="jpy">
      <label for="cv-jpy" class="text-[12px] font-semibold text-ink-muted">
        {t(lang, 'guide.jpy')}
      </label>
      <div class="glass glass--light glass-pill flex items-center gap-2 px-5">
        <input
          id="cv-jpy"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          value={yenPer(initialVnd)}
          class="font-latin min-h-[52px] min-w-0 flex-1 bg-transparent text-[24px] font-semibold text-ink outline-none"
        />
        <span class="text-[15px] text-ink-muted" aria-hidden="true">
          円
        </span>
      </div>
    </div>
  </form>

  <p class="mt-4 mb-1 text-[12px] font-semibold text-ink-muted" id="cv-quick-label">
    {t(lang, 'guide.quick')}
  </p>
  <div class="h-scroll" role="group" aria-labelledby="cv-quick-label">
    {quick.map((v) => (
      <GlassChip variant="light" class="font-latin" data-cv-quick={v}>
        {v.toLocaleString('ja-JP')}₫
      </GlassChip>
    ))}
  </div>

  <div class="mt-3 border-t border-line pt-3 text-[12px] text-ink-muted">
    <p class="font-semibold text-ink" data-rate-date>
      {t(lang, 'guide.rateAsOf', { date: formatJaDate(rate.asOf) })}
      <span class="font-latin font-normal text-ink-muted">
        ・ 1円 ≈ {Math.round(1 / rate.jpyPerVnd).toLocaleString('ja-JP')}₫
      </span>
    </p>
    <p>
      {t(lang, 'guide.rateNote')}
      {sourceKnown && (
        <span>
          （{t(lang, 'guide.rateSource')}: {rate.source}）
        </span>
      )}
    </p>
  </div>
</GlassPanel>

<script>
  const root = document.querySelector<HTMLElement>('[data-converter]');
  if (root) {
    const r = Number(root.dataset.rate);
    const vnd = root.querySelector<HTMLInputElement>('#cv-vnd')!;
    const jpy = root.querySelector<HTMLInputElement>('#cv-jpy')!;
    const fields = root.querySelector<HTMLElement>('[data-cv-fields]')!;
    const parse = (s: string) => Number(s.normalize('NFKC').replace(/[^\d.]/g, '')) || 0;
    fields.addEventListener('submit', (e) => e.preventDefault()); // Enter on mobile keyboards
    const fmt = (n: number) => (n ? Math.round(n).toLocaleString('ja-JP') : '');

    // Only the *other* field is reformatted while typing, so the caret never jumps.
    vnd.addEventListener('input', () => (jpy.value = fmt(parse(vnd.value) * r)));
    jpy.addEventListener('input', () => (vnd.value = fmt(parse(jpy.value) / r)));
    for (const el of [vnd, jpy])
      el.addEventListener('blur', () => (el.value = fmt(parse(el.value))));

    root.querySelector('[data-cv-swap]')!.addEventListener('click', () => {
      fields.classList.toggle('flex-col-reverse');
      fields.classList.toggle('flex-col');
      (fields.classList.contains('flex-col-reverse') ? jpy : vnd).focus();
    });
    for (const chip of root.querySelectorAll<HTMLElement>('[data-cv-quick]')) {
      chip.addEventListener('click', () => {
        const v = Number(chip.dataset.cvQuick);
        vnd.value = fmt(v);
        jpy.value = fmt(v * r);
      });
    }
  }
</script>

<style>
  .cv-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cv-field:focus-within .glass {
    outline: 2px solid var(--color-amber);
    outline-offset: 2px;
  }
  .cv-field input:focus-visible {
    outline: none;
  }
</style>
