---
// Phase-0 placeholder body for stub pages. Delete once no page imports it.
import GlassPanel from './glass/GlassPanel.astro';

interface Props {
  title: string;
  owner: 'A' | 'C';
  data?: unknown;
}
const { title, owner, data } = Astro.props;
---

<div class="mx-auto max-w-3xl px-4">
  <GlassPanel variant="strong" padding="lg">
    <h1 class="text-2xl">{title}</h1>
    <p class="text-ink-muted">STUB — Agent {owner}</p>
    {data !== undefined && <pre class="mt-4 overflow-x-auto text-xs whitespace-pre-wrap">
          {JSON.stringify(data, null, 2)}
        </pre>}
  </GlassPanel>
</div>
