---
// 指さし会話帳: search + scene chips + phrase cards + 見せるモード.
// Client JS: filtering, speechSynthesis (vi-VN; buttons hidden when the device has no Vietnamese
// voice), full-screen show mode with Wake Lock and swipe-down-to-close.
import type { CollectionEntry } from 'astro:content';
import GlassSearch from '../glass/GlassSearch.astro';
import GlassChip from '../glass/GlassChip.astro';
import Icon from '../glass/Icon.astro';
import PhraseCard from './PhraseCard.astro';
import ShowMode from './ShowMode.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
  groups: CollectionEntry<'phrases'>[];
}
const { lang, groups } = Astro.props;
const countTpl = t(lang, 'phrases.count', { n: '{n}' });
---

<div class="space-y-5" data-phrasebook data-count-tpl={countTpl}>
  <GlassSearch
    label={t(lang, 'phrases.search')}
    placeholder={t(lang, 'phrases.search')}
    submitLabel={t(lang, 'common.search')}
    id="phrase-search"
  />

  <div class="h-scroll" role="group" aria-label={t(lang, 'phrases.groupsLabel')}>
    <GlassChip selected data-group="all">
      {t(lang, 'phrases.all')}
    </GlassChip>
    {groups.map((g) => (
      <GlassChip data-group={g.id}>{g.data.titleJa}</GlassChip>
    ))}
  </div>

  <p class="flex gap-2 text-[12px] text-ink-muted">
    <Icon name="info" size={16} class="mt-0.5 shrink-0 text-river" />
    {t(lang, 'phrases.southNote')}
  </p>

  {groups.map((g) => (
    <section class="space-y-3" data-group-section={g.id} aria-labelledby={`pg-${g.id}`}>
      <h2 id={`pg-${g.id}`} class="font-sans! text-[15px] font-bold">
        {g.data.titleJa}
        <span class="font-normal text-ink-muted">
          ・ <span data-count>{countTpl.replace('{n}', String(g.data.phrases.length))}</span>
        </span>
      </h2>
      <ul class="m-0 grid list-none gap-3 p-0 md:grid-cols-2">
        {g.data.phrases.map((p) => (
          <PhraseCard lang={lang} ja={p.ja} vi={p.vi} kana={p.kana} note={p.note} />
        ))}
      </ul>
    </section>
  ))}

  <p class="tile-pattern glass-radius py-10 text-center text-ink-muted" data-empty hidden>
    {t(lang, 'common.noResults')}
  </p>

  <!-- Below the list on purpose: it appears ~1s after load (voice detection), and near the top it
       would become the LCP element. The same note is shown inside 見せるモード. -->
  <p
    class="glass glass--light glass-radius flex gap-2 p-3 text-[13px] text-ink-muted"
    data-no-voice
    hidden
    role="status"
  >
    <Icon name="alert" size={18} class="mt-0.5 shrink-0 text-amber" />
    {t(lang, 'phrases.noVoice')}
  </p>
</div>

<ShowMode lang={lang} />

<script>
  import { searchKey } from './search';
  import { phraseTools } from './client';

  const root = document.querySelector<HTMLElement>('[data-phrasebook]');
  const dialog = document.querySelector<HTMLDialogElement>('#show-mode');

  if (root && dialog) {
    const countTpl = root.dataset.countTpl ?? '{n}';
    const input = root.querySelector<HTMLInputElement>('#phrase-search')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-group]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-group-section]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let group = 'all';

    // ───── Filtering (scene chips + search) ─────
    const apply = () => {
      const q = searchKey(input.value.trim());
      let total = 0;
      for (const s of sections) {
        let n = 0;
        for (const card of s.querySelectorAll<HTMLElement>('[data-phrase]')) {
          const hit = !q || (card.dataset.search ?? '').includes(q);
          card.hidden = !hit;
          if (hit) n++;
        }
        s.querySelector('[data-count]')!.textContent = countTpl.replace('{n}', String(n));
        s.hidden = n === 0 || (group !== 'all' && s.dataset.groupSection !== group);
        if (!s.hidden) total += n;
      }
      empty.hidden = total > 0;
    };
    const select = (g: string) => {
      group = g;
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.group === g));
      for (const c of chips) c.toggleAttribute('data-selected', c.dataset.group === g);
      apply();
    };
    for (const c of chips) c.addEventListener('click', () => select(c.dataset.group ?? 'all'));
    input.addEventListener('input', () => {
      // A search looks through every scene.
      if (input.value.trim() && group !== 'all') select('all');
      else apply();
    });
    const fromHash = decodeURIComponent(location.hash.slice(1));
    if (chips.some((c) => c.dataset.group === fromHash)) select(fromHash);

    const tools = phraseTools()!;
    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const card = target.closest<HTMLElement>('[data-phrase]');
      if (!card) return;
      const { ja = '', vi = '', kana = '' } = card.dataset;
      if (target.closest('[data-show]')) tools.show(ja, vi, kana);
      else if (target.closest('[data-speak]')) tools.speak(vi);
    });
  }
</script>
