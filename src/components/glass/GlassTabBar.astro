---
import Icon, { type IconName } from './Icon.astro';

export interface TabItem {
  href: string;
  label: string;
  icon: IconName;
}

interface Props {
  items: TabItem[];
  /** Index of the active tab, or -1 for none. */
  active: number;
  /** aria-label of the <nav>. */
  label: string;
}

const { items, active, label } = Astro.props;
---

<nav
  class="glass-tabbar glass glass--refract glass-pill"
  aria-label={label}
  style={`--count:${items.length};--active:${Math.max(active, 0)}`}
  data-has-active={active >= 0 ? '' : undefined}
>
  <span class="glass-tabbar__drop" aria-hidden="true"></span>
  {items.map((item, i) => (
    <a
      href={item.href}
      class="glass-tabbar__item"
      aria-current={i === active ? 'page' : undefined}
      data-index={i}
    >
      <Icon name={item.icon} size={22} />
      <span class="glass-tabbar__label">{item.label}</span>
    </a>
  ))}
</nav>

<script>
  // Slide the glass drop toward the tapped tab before navigation (visual only).
  for (const bar of document.querySelectorAll<HTMLElement>('.glass-tabbar')) {
    bar.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
      if (a) {
        bar.dataset.hasActive = '';
        bar.style.setProperty('--active', a.dataset.index ?? '0');
      }
    });
  }
</script>

<style>
  .glass-tabbar {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: calc(var(--tabbar-gap) + var(--safe-bottom));
    transform: translateX(-50%);
    width: min(calc(100% - 2 * var(--spacing-gutter)), 480px);
    height: var(--tabbar-h);
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    padding: 4px;
    /* Liquid glass: mostly clear, light blur so what scrolls underneath stays visible. */
    --glass-bg: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.5) 0%,
      rgb(255 255 255 / 0.3) 55%,
      rgb(255 255 255 / 0.42) 100%
    );
    --glass-blur: 16px;
    --glass-saturate: 190%;
    border-color: rgb(255 255 255 / 0.55);
    box-shadow:
      inset 0 1px 0.5px rgb(255 255 255 / 0.95),
      inset 0 -1px 1px rgb(255 255 255 / 0.35),
      inset 0 10px 18px -12px rgb(255 255 255 / 0.7),
      inset 0 0 0 0.5px rgb(23 32 51 / 0.08),
      0 12px 32px -12px rgb(20 28 46 / 0.35);
  }
  /* No backdrop-filter → stay readable */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-tabbar {
      --glass-bg: rgb(255 255 255 / 0.92);
    }
  }
  .glass-tabbar__drop {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / var(--count));
    border-radius: var(--radius-pill);
    /* the active "drop": a brighter lens of glass with a warm tint */
    background: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.75),
      color-mix(in srgb, var(--color-amber) 14%, rgb(255 255 255 / 0.5))
    );
    box-shadow:
      inset 0 1px 0.5px rgb(255 255 255 / 1),
      inset 0 0 0 1px color-mix(in srgb, var(--color-amber) 22%, transparent),
      0 4px 12px -6px rgb(20 28 46 / 0.3);
    transform: translateX(calc(var(--active) * 100%));
    transition: transform 320ms var(--ease-spring);
    opacity: 0;
  }
  .glass-tabbar[data-has-active] .glass-tabbar__drop {
    opacity: 1;
  }
  .glass-tabbar__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 600;
    -webkit-tap-highlight-color: transparent;
    transition: color 200ms var(--ease-out-soft);
  }
  .glass-tabbar__item[aria-current='page'] {
    color: var(--color-amber);
  }
  .glass-tabbar__item:active {
    transform: scale(0.94);
  }
</style>
