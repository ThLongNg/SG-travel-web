---
import Icon, { type IconName } from './Icon.astro';

export interface TabItem {
  href: string;
  label: string;
  icon: IconName;
}

interface Props {
  items: TabItem[];
  /** Index of the active tab, or -1 for none. */
  active: number;
  /** aria-label of the <nav>. */
  label: string;
}

const { items, active, label } = Astro.props;
---

<nav
  class="glass-tabbar glass glass-pill"
  aria-label={label}
  style={`--count:${items.length};--active:${Math.max(active, 0)}`}
  data-has-active={active >= 0 ? '' : undefined}
>
  <span class="glass-tabbar__drop" aria-hidden="true"></span>
  {items.map((item, i) => (
    <a
      href={item.href}
      class="glass-tabbar__item"
      aria-current={i === active ? 'page' : undefined}
      data-index={i}
    >
      <Icon name={item.icon} size={22} />
      <span class="glass-tabbar__label">{item.label}</span>
    </a>
  ))}
</nav>

<script>
  // Slide the glass drop toward the tapped tab before navigation (visual only).
  for (const bar of document.querySelectorAll<HTMLElement>('.glass-tabbar')) {
    bar.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
      if (a) {
        bar.dataset.hasActive = '';
        bar.style.setProperty('--active', a.dataset.index ?? '0');
      }
    });
  }
</script>

<style>
  .glass-tabbar {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: calc(var(--tabbar-gap) + var(--safe-bottom));
    transform: translateX(-50%);
    width: min(calc(100% - 2 * var(--spacing-gutter)), 480px);
    height: var(--tabbar-h);
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    padding: 4px;
    --glass-bg: linear-gradient(160deg, rgb(40 48 96 / 0.55), rgb(14 20 48 / 0.6));
  }
  .glass-tabbar__drop {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / var(--count));
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.18);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 2px 10px rgb(0 0 0 / 0.2);
    transform: translateX(calc(var(--active) * 100%));
    transition: transform 320ms var(--ease-spring);
    opacity: 0;
  }
  .glass-tabbar[data-has-active] .glass-tabbar__drop {
    opacity: 1;
  }
  .glass-tabbar__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 500;
    -webkit-tap-highlight-color: transparent;
    transition: color 200ms var(--ease-out-soft);
  }
  .glass-tabbar__item[aria-current='page'] {
    color: var(--color-amber);
  }
  .glass-tabbar__item:active {
    transform: scale(0.94);
  }
</style>
