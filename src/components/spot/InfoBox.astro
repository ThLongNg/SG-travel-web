---
// 基本情報: compact 2-column icon grid on strong glass (pattern from /dev/glass spot preview).
import GlassPanel from '../glass/GlassPanel.astro';
import Icon, { type IconName } from '../glass/Icon.astro';
import { t, type Locale } from '../../lib/i18n';
import { formatDuration, formatPrice } from '../../lib/format';
import { regionLabel, seasonText, triState, type Spot } from './spot-utils';

interface Props {
  spot: Spot;
  lang: Locale;
}

const { spot, lang } = Astro.props;
const d = spot.data;
const price = d.info.priceVnd === null ? t(lang, 'common.unknown') : formatPrice(d.info.priceVnd);

const rows: { icon: IconName; label: string; value: string; note?: string; wide?: boolean }[] = [
  { icon: 'pin', label: t(lang, 'spots.area'), value: `${regionLabel(lang, d.area)} · ${d.city}` },
  { icon: 'clock', label: t(lang, 'spots.hours'), value: d.info.hours },
  { icon: 'ticket', label: t(lang, 'spots.price'), value: price, note: d.info.priceNote },
  {
    icon: 'hourglass',
    label: t(lang, 'spots.duration'),
    value: formatDuration(d.info.durationMinutes),
  },
  { icon: 'sun', label: t(lang, 'spots.bestSeason'), value: seasonText(lang, d.bestSeasons) },
  { icon: 'toilet', label: t(lang, 'spots.toilet'), value: triState(lang, d.info.toilet) },
  { icon: 'card', label: t(lang, 'spots.card'), value: triState(lang, d.info.cardPayment) },
  { icon: 'wifi', label: t(lang, 'spots.wifi'), value: triState(lang, d.info.wifi) },
  { icon: 'train', label: t(lang, 'spots.access'), value: d.info.access, wide: true },
];
---

<GlassPanel as="section" aria-labelledby="spot-info" variant="strong">
  <h2 id="spot-info" class="mb-4 font-sans text-[17px] font-bold">
    {t(lang, 'spots.basicInfo')}
  </h2>
  <dl class="m-0 grid grid-cols-2 gap-x-4 gap-y-5">
    {rows.map((r) => (
      <div class:list={['flex gap-3', r.wide && 'col-span-2']}>
        <span class="icon-badge size-9!">
          <Icon name={r.icon} size={18} />
        </span>
        <div class="min-w-0">
          <dt class="text-xs text-ink-muted">{r.label}</dt>
          <dd class="m-0 text-[15px] leading-snug font-semibold break-words">{r.value}</dd>
          {r.note && <dd class="m-0 mt-0.5 text-xs text-ink-muted">{r.note}</dd>}
        </div>
      </div>
    ))}
  </dl>
  <slot />
</GlassPanel>
