---
// Swipe gallery (CSS scroll-snap) with floating glass buttons (back / favorite / share),
// a "1 / N" counter, and tap-to-fullscreen (native <dialog> lightbox).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import GlassButton from '../glass/GlassButton.astro';
import Icon from '../glass/Icon.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
  slug: string;
  name: string;
  images: { src: ImageMetadata; alt: string }[];
  backHref: string;
}

const { lang, slug, name, images, backHref } = Astro.props;
---

<div class="spot-gallery relative" data-spot-gallery data-slug={slug}>
  <ul
    class="spot-gallery__track m-0 flex list-none snap-x snap-mandatory overflow-x-auto rounded-[20px] bg-night-2 p-0 md:rounded-[24px]"
    aria-label={t(lang, 'spots.gallery')}
    tabindex="0"
  >
    {images.map((img, i) => (
      <li class="w-full shrink-0 snap-start snap-always">
        <button
          type="button"
          class="block aspect-[4/3] w-full cursor-zoom-in bg-night-2 p-0 md:aspect-[16/9]"
          data-lightbox-index={i}
          aria-label={`${img.alt}（${i + 1} / ${images.length}）`}
        >
          <Image
            src={img.src}
            alt={img.alt}
            widths={[390, 780, 1170, 1600]}
            sizes="(min-width: 1024px) 1024px, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="h-full w-full object-cover"
          />
        </button>
      </li>
    ))}
  </ul>

  <div class="pointer-events-none absolute inset-x-3 top-3 flex justify-between">
    <GlassButton
      href={backHref}
      iconOnly
      icon="back"
      label={t(lang, 'nav.back')}
      class="pointer-events-auto"
      data-back
    />
    <div class="pointer-events-auto flex gap-2">
      <GlassButton
        iconOnly
        icon="heart"
        label={t(lang, 'common.favorite')}
        class="spot-fav"
        aria-pressed="false"
        data-fav
        data-label-on={t(lang, 'common.favorited')}
        data-label-off={t(lang, 'common.favorite')}
      />
      <GlassButton iconOnly icon="share" label={t(lang, 'common.share')} data-share={name} />
    </div>
  </div>
  {images.length > 1 && (
    <span class="absolute right-3 bottom-3" aria-hidden="true">
      <span class="glass glass-pill font-latin block px-3 py-1 text-xs" data-counter>
        1 / {images.length}
      </span>
    </span>
  )}

  <dialog class="spot-lightbox" aria-label={t(lang, 'spots.gallery')}>
    <ul class="spot-lightbox__track m-0 flex h-full list-none snap-x snap-mandatory overflow-x-auto p-0">
      {images.map((img) => (
        <li class="grid h-full w-full shrink-0 snap-start place-items-center">
          <Image
            src={img.src}
            alt={img.alt}
            widths={[780, 1600]}
            sizes="100vw"
            loading="lazy"
            class="max-h-full w-full object-contain"
          />
        </li>
      ))}
    </ul>
    <button
      type="button"
      class="glass glass-pill glass-press touch-target spot-lightbox__close grid place-items-center"
      aria-label={t(lang, 'common.close')}
      data-lightbox-close
    >
      <Icon name="close" />
    </button>
  </dialog>
</div>

<script>
  const KEY = 'sgt:favorites';
  const readFavs = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '[]') as string[];
    } catch {
      return [];
    }
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-spot-gallery]')) {
    const track = root.querySelector<HTMLElement>('.spot-gallery__track')!;
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const total = track.children.length;

    // Counter follows the swipe position
    if (counter) {
      let raf = 0;
      track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const i = Math.round(track.scrollLeft / track.clientWidth);
            counter.textContent = `${i + 1} / ${total}`;
          });
        },
        { passive: true },
      );
    }

    // Back: return to the previous page when it was on this site, else follow the link (spot list)
    root.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (e) => {
      if (history.length > 1 && document.referrer.startsWith(location.origin)) {
        e.preventDefault();
        history.back();
      }
    });

    // Favorite (stored locally)
    const slug = root.dataset.slug!;
    const fav = root.querySelector<HTMLButtonElement>('[data-fav]')!;
    const paintFav = (on: boolean) => {
      fav.setAttribute('aria-pressed', String(on));
      fav.setAttribute('aria-label', on ? fav.dataset.labelOn! : fav.dataset.labelOff!);
    };
    paintFav(readFavs().includes(slug));
    fav.addEventListener('click', () => {
      const favs = new Set(readFavs());
      const on = !favs.has(slug);
      if (on) favs.add(slug);
      else favs.delete(slug);
      try {
        localStorage.setItem(KEY, JSON.stringify([...favs]));
      } catch {
        /* storage unavailable (private mode): keep the visual state only */
      }
      paintFav(on);
    });

    // Share: Web Share API, else copy the URL
    const share = root.querySelector<HTMLButtonElement>('[data-share]')!;
    share.addEventListener('click', async () => {
      const data = { title: share.dataset.share, url: location.href };
      if (navigator.share) {
        await navigator.share(data).catch(() => {});
      } else {
        await navigator.clipboard?.writeText(location.href).catch(() => {});
        share.classList.add('is-copied');
        setTimeout(() => share.classList.remove('is-copied'), 1500);
      }
    });

    // Lightbox
    const dialog = root.querySelector<HTMLDialogElement>('.spot-lightbox')!;
    const lbTrack = dialog.querySelector<HTMLElement>('.spot-lightbox__track')!;
    track.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-index]');
      if (!btn) return;
      dialog.showModal();
      lbTrack.scrollLeft = Number(btn.dataset.lightboxIndex) * lbTrack.clientWidth;
    });
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'LI') dialog.close();
    });
  }
</script>

<style>
  .spot-gallery__track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .spot-gallery__track::-webkit-scrollbar,
  .spot-lightbox__track::-webkit-scrollbar {
    display: none;
  }
  :global(.spot-fav[aria-pressed='true']) {
    color: var(--color-amber);
  }
  :global(.spot-fav[aria-pressed='true'] svg) {
    fill: currentColor;
  }
  :global([data-share].is-copied) {
    color: var(--color-river);
  }
  .spot-lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(3 8 16 / 0.96);
  }
  .spot-lightbox::backdrop {
    background: rgb(3 8 16 / 0.8);
  }
  .spot-lightbox__track {
    scrollbar-width: none;
  }
  .spot-lightbox__close {
    position: absolute;
    top: calc(var(--safe-top) + 12px);
    right: 12px;
  }
</style>
