---
// Footer of a content page: 情報更新日 + 出典 (+ dev-only 情報確認中 badge lives in VerifyBadge).
import Icon from '../glass/Icon.astro';
import { t, type Locale } from '../../lib/i18n';
import { formatJaDate } from '../../lib/format';

interface Props {
  lang: Locale;
  lastVerified: Date;
  sources: { title: string; url: string }[];
}

const { lang, lastVerified, sources } = Astro.props;
---

<footer class="space-y-3 border-t border-white/10 pt-5 text-[13px] text-ink-muted">
  <p class="flex items-center gap-2">
    <Icon name="calendar" size={16} />
    {t(lang, 'common.lastUpdated')}：
    <time datetime={lastVerified.toISOString().slice(0, 10)}>{formatJaDate(lastVerified)}</time>
  </p>
  <div>
    <p class="font-semibold text-ink">{t(lang, 'common.sources')}</p>
    <ul class="m-0 mt-1 list-none space-y-1 p-0">
      {sources.map((s) => (
        <li>
          <a
            href={s.url}
            rel="noopener noreferrer external"
            target="_blank"
            class="inline-flex min-h-[32px] items-center gap-1 text-river underline-offset-2 hover:underline"
          >
            {s.title}
            <Icon name="external" size={14} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
