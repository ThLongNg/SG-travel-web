---
// 翻訳 bubble: a floating button on every page that opens a translation sheet.
// - 日本語 → ベトナム語: natural Saigon Vietnamese + katakana reading + a back-translation to check it,
//   then 全画面で見せる (the shared <ShowMode>) and 読み上げ (vi-VN speech).
// - ベトナム語 → 日本語: hand the phone to the other person to type.
// Calls POST /api/translate (Vercel Function, api/translate.ts). Needs a connection.
import GlassSheet from '../glass/GlassSheet.astro';
import Icon from '../glass/Icon.astro';
import { localizePath, t, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<button
  type="button"
  class="translate-fab glass-press touch-target"
  data-sheet-open="translate-sheet"
  aria-haspopup="dialog"
  aria-label={t(lang, 'translate.open')}
>
  <Icon name="translate" size={26} />
</button>

<GlassSheet
  id="translate-sheet"
  title={t(lang, 'translate.title')}
  closeLabel={t(lang, 'common.close')}
>
  <form class="space-y-3" data-tr-form novalidate>
    <div
      class="grid grid-cols-2 gap-1 rounded-full bg-sand/80 p-1"
      role="group"
      aria-label={t(lang, 'translate.direction')}
    >
      <button type="button" class="tr-dir glass-press" data-tr-dir="ja-vi" aria-pressed="true">
        {t(lang, 'translate.jaToVi')}
      </button>
      <button type="button" class="tr-dir glass-press" data-tr-dir="vi-ja" aria-pressed="false">
        {t(lang, 'translate.viToJa')}
      </button>
    </div>
    <label class="sr-only" for="tr-input">
      {t(lang, 'translate.inputLabel')}
    </label>
    <textarea
      id="tr-input"
      class="block min-h-[96px] w-full resize-none rounded-2xl border border-line bg-white p-3 text-[17px] leading-relaxed"
      maxlength="200"
      rows="3"
      data-tr-input
      data-ph-ja-vi={t(lang, 'translate.placeholderJa')}
      data-ph-vi-ja={t(lang, 'translate.placeholderVi')}
      placeholder={t(lang, 'translate.placeholderJa')}
    ></textarea>
    <button
      type="submit"
      class="glass-press touch-target flex w-full items-center justify-center gap-2 rounded-full bg-amber px-6 py-3 text-[16px] font-bold text-ink-dark disabled:opacity-60"
      data-tr-submit
      data-label={t(lang, 'translate.submit')}
      data-busy={t(lang, 'translate.busy')}
    >
      <Icon name="translate" size={18} />
      <span data-tr-submit-label>{t(lang, 'translate.submit')}</span>
    </button>
  </form>

  <p class="mt-3 rounded-2xl bg-sand/70 p-3 text-[14px]" data-tr-error role="status" hidden></p>

  <section
    class="mt-4 space-y-3 rounded-2xl border border-line bg-white/80 p-4"
    data-tr-result
    hidden
    aria-live="polite"
  >
    <!-- ja→vi: Vietnamese first (to show); vi→ja: Japanese first (to read) -->
    <p class="font-latin m-0 text-[26px] leading-snug font-bold" lang="vi" data-tr-vi></p>
    <p class="m-0 text-[15px] font-semibold text-river" data-tr-kana></p>
    <p class="m-0 text-[22px] leading-snug font-bold" data-tr-ja-big hidden></p>
    <p class="m-0 text-[13px] text-ink-muted" data-tr-back-wrap>
      {t(lang, 'translate.backLabel')}
      <span data-tr-back></span>
    </p>
    <p class="m-0 flex gap-1.5 text-[13px] text-ink-muted" data-tr-note-wrap hidden>
      <Icon name="info" size={16} class="mt-0.5 shrink-0 text-amber" />
      <span data-tr-note></span>
    </p>
    <div class="grid grid-cols-2 gap-2">
      <button
        type="button"
        class="glass-press touch-target flex items-center justify-center gap-1.5 rounded-full bg-amber px-3 text-[14px] font-bold text-ink-dark"
        data-tr-show
      >
        <Icon name="expand" size={18} />
        {t(lang, 'translate.showFull')}
      </button>
      <button
        type="button"
        class="glass-press touch-target flex items-center justify-center gap-1.5 rounded-full border border-line bg-white px-3 text-[14px] font-bold"
        data-speak
        data-tr-speak
        hidden
      >
        <Icon name="speaker" size={18} />
        {t(lang, 'translate.speak')}
      </button>
    </div>
  </section>

  <p class="mt-4 text-[11px] leading-relaxed text-ink-muted">
    {t(lang, 'translate.privacy')}
    <a href={localizePath('/phrases/', lang)}>{t(lang, 'translate.phrasebookLink')}</a>
  </p>
</GlassSheet>

<script>
  import { phraseTools } from '../phrase/client';

  type Dir = 'ja-vi' | 'vi-ja';
  interface Result {
    vi: string;
    kana: string;
    ja: string;
    note: string;
  }

  const sheet = document.getElementById('translate-sheet');
  if (sheet) {
    const $ = <T extends HTMLElement>(s: string) => sheet.querySelector<T>(s)!;
    const form = $<HTMLFormElement>('[data-tr-form]');
    const input = $<HTMLTextAreaElement>('[data-tr-input]');
    const submit = $<HTMLButtonElement>('[data-tr-submit]');
    const submitLabel = $('[data-tr-submit-label]');
    const errorBox = $('[data-tr-error]');
    const result = $('[data-tr-result]');
    const dirButtons = [...sheet.querySelectorAll<HTMLButtonElement>('[data-tr-dir]')];
    const messages = JSON.parse(
      document.querySelector<HTMLElement>('[data-tr-messages]')?.textContent ?? '{}',
    ) as Record<string, string>;
    let dir: Dir = 'ja-vi';
    let last: { dir: Dir; input: string; r: Result } | null = null;

    const setDir = (d: Dir) => {
      dir = d;
      for (const b of dirButtons) b.setAttribute('aria-pressed', String(b.dataset.trDir === d));
      input.placeholder = input.dataset[d === 'ja-vi' ? 'phJaVi' : 'phViJa'] ?? '';
      input.lang = d === 'ja-vi' ? 'ja' : 'vi';
    };
    for (const b of dirButtons) b.addEventListener('click', () => setDir(b.dataset.trDir as Dir));

    const showError = (key: string) => {
      errorBox.textContent = messages[key] ?? messages.failed;
      errorBox.hidden = false;
    };

    const render = (d: Dir, text: string, r: Result) => {
      last = { dir: d, input: text, r };
      $('[data-tr-vi]').textContent = r.vi;
      $('[data-tr-kana]').textContent = r.kana;
      const jaBig = $('[data-tr-ja-big]');
      jaBig.textContent = r.ja;
      jaBig.hidden = d === 'ja-vi';
      $('[data-tr-back]').textContent = r.ja;
      $('[data-tr-back-wrap]').hidden = d === 'vi-ja';
      // vi→ja: the Japanese is what she reads, so it goes on top
      if (d === 'vi-ja') result.prepend(jaBig);
      else result.append(jaBig);
      $('[data-tr-note]').textContent = r.note;
      $('[data-tr-note-wrap]').hidden = !r.note;
      $('[data-tr-show]').hidden = d === 'vi-ja';
      result.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      errorBox.hidden = true;
      if (!text) return input.focus();
      if (!navigator.onLine) return showError('offline');

      submit.disabled = true;
      submitLabel.textContent = submit.dataset.busy ?? '';
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 25_000);
      try {
        const res = await fetch('/api/translate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text, dir }),
          signal: ctrl.signal,
        });
        if (res.ok) render(dir, text, (await res.json()) as Result);
        else if (res.status === 503 || res.status === 404) showError('unavailable');
        else if (res.status === 429) showError('busy');
        else showError('failed');
      } catch {
        showError(navigator.onLine ? 'failed' : 'offline');
      } finally {
        clearTimeout(timer);
        submit.disabled = false;
        submitLabel.textContent = submit.dataset.label ?? '';
      }
    });

    // Enter sends on desktop keyboards; Shift+Enter keeps a newline. IME composition is respected.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    const tools = phraseTools();
    $('[data-tr-show]').addEventListener('click', () => {
      if (last && tools) tools.show(last.input, last.r.vi, last.r.kana);
    });
    $('[data-tr-speak]').addEventListener('click', () => {
      if (last && tools) tools.speak(last.r.vi);
    });
  }
</script>

<script
  type="application/json"
  data-tr-messages
  is:inline
  set:html={JSON.stringify({
    offline: t(lang, 'translate.errOffline'),
    unavailable: t(lang, 'translate.errUnavailable'),
    busy: t(lang, 'translate.errBusy'),
    failed: t(lang, 'translate.errFailed'),
  })}
/>
<style>
  .translate-fab {
    position: fixed;
    z-index: 39; /* below the tab bar (40) and every dialog */
    right: var(--spacing-gutter);
    bottom: calc(var(--tabbar-h) + var(--tabbar-gap) * 2 + var(--safe-bottom));
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    color: var(--color-ink-dark);
    background: var(--color-amber);
    box-shadow:
      inset 0 1px 0.5px rgb(255 255 255 / 0.6),
      0 10px 24px -8px rgb(120 50 0 / 0.55);
  }
  .tr-dir {
    min-height: 44px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  .tr-dir[aria-pressed='true'] {
    background: #fff;
    color: var(--color-amber);
    box-shadow: 0 2px 8px -4px rgb(20 28 46 / 0.3);
  }
</style>
