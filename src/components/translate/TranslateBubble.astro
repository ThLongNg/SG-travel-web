---
// 翻訳 bubble: a floating button on every page that opens a translation sheet.
// - 日本語 → ベトナム語: natural Saigon Vietnamese + katakana reading + a back-translation to check it,
//   then 全画面で見せる (the shared <ShowMode>) and 読み上げ (vi-VN speech).
// - ベトナム語 → 日本語: hand the phone over; the other person types or speaks (🎤).
// - メニューを撮る: a menu photo read into Japanese names, prices in yen and ★ picks; これください → 見せる.
// - ★ saves a translation (offline); repeated sentences come from a local cache (no API call).
// Logic: ./client.ts. API: POST /api/translate/ (Vercel Function, api/translate.ts).
import GlassSheet from '../glass/GlassSheet.astro';
import Icon from '../glass/Icon.astro';
import { localizePath, t, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const pill =
  'glass-press touch-target flex items-center justify-center gap-1.5 rounded-full px-3 text-[14px] font-bold';
---

<button
  type="button"
  class="translate-fab glass-press touch-target"
  data-sheet-open="translate-sheet"
  aria-haspopup="dialog"
  aria-label={t(lang, 'translate.open')}
>
  <Icon name="translate" size={26} />
</button>

<GlassSheet
  id="translate-sheet"
  title={t(lang, 'translate.title')}
  closeLabel={t(lang, 'common.close')}
>
  <form class="space-y-3" data-tr-form novalidate>
    <div
      class="grid grid-cols-2 gap-1 rounded-full bg-sand/80 p-1"
      role="group"
      aria-label={t(lang, 'translate.direction')}
    >
      <button type="button" class="tr-dir glass-press" data-tr-dir="ja-vi" aria-pressed="true">
        {t(lang, 'translate.jaToVi')}
      </button>
      <button type="button" class="tr-dir glass-press" data-tr-dir="vi-ja" aria-pressed="false">
        {t(lang, 'translate.viToJa')}
      </button>
    </div>
    <label class="sr-only" for="tr-input">
      {t(lang, 'translate.inputLabel')}
    </label>
    <div class="relative">
      <textarea
        id="tr-input"
        class="block min-h-[96px] w-full resize-none rounded-2xl border border-line bg-white p-3 pr-14 text-[17px] leading-relaxed"
        maxlength="200"
        rows="3"
        data-tr-input
        data-ph-ja-vi={t(lang, 'translate.placeholderJa')}
        data-ph-vi-ja={t(lang, 'translate.placeholderVi')}
        placeholder={t(lang, 'translate.placeholderJa')}
      ></textarea>
      <button
        type="button"
        class="tr-mic glass-press touch-target absolute right-2 bottom-2 grid place-items-center rounded-full"
        data-tr-mic
        aria-pressed="false"
        aria-label={t(lang, 'translate.mic')}
        hidden
      >
        <Icon name="mic" size={22} />
      </button>
    </div>
    <div class="grid grid-cols-[1fr_auto] gap-2">
      <button
        type="submit"
        class="glass-press touch-target flex items-center justify-center gap-2 rounded-full bg-amber px-6 py-3 text-[16px] font-bold text-ink-dark disabled:opacity-60"
        data-tr-submit
        data-label={t(lang, 'translate.submit')}
        data-busy={t(lang, 'translate.busy')}
      >
        <Icon name="translate" size={18} />
        <span data-tr-submit-label>{t(lang, 'translate.submit')}</span>
      </button>
      <label
        class:list={[pill, 'cursor-pointer border border-line bg-white']}
        data-tr-camera-label
        data-busy={t(lang, 'translate.menuBusy')}
      >
        <Icon name="camera" size={18} class="text-river" />
        {t(lang, 'translate.camera')}
        <input type="file" accept="image/*" capture="environment" class="sr-only" data-tr-camera />
      </label>
    </div>
  </form>

  <p class="mt-3 rounded-2xl bg-sand/70 p-3 text-[14px]" data-tr-error role="status" hidden></p>

  <section
    class="mt-4 space-y-3 rounded-2xl border border-line bg-white/80 p-4"
    data-tr-result
    hidden
    aria-live="polite"
  >
    <!-- ja→vi: Vietnamese first (to show); vi→ja: Japanese first (to read) -->
    <p class="font-latin m-0 text-[26px] leading-snug font-bold" lang="vi" data-tr-vi></p>
    <p class="m-0 text-[15px] font-semibold text-river" data-tr-kana></p>
    <p class="m-0 text-[22px] leading-snug font-bold" data-tr-ja-big hidden></p>
    <p class="m-0 text-[13px] text-ink-muted" data-tr-back-wrap>
      {t(lang, 'translate.backLabel')}
      <span data-tr-back></span>
    </p>
    <p class="m-0 flex gap-1.5 text-[13px] text-ink-muted" data-tr-note-wrap hidden>
      <Icon name="info" size={16} class="mt-0.5 shrink-0 text-amber" />
      <span data-tr-note></span>
    </p>
    <div class="flex flex-wrap gap-2">
      <button type="button" class:list={[pill, 'flex-1 bg-amber text-ink-dark']} data-tr-show>
        <Icon name="expand" size={18} />
        {t(lang, 'translate.showFull')}
      </button>
      <button
        type="button"
        class:list={[pill, 'border border-line bg-white']}
        data-speak
        data-tr-speak
        hidden
      >
        <Icon name="speaker" size={18} />
        {t(lang, 'translate.speak')}
      </button>
      <button
        type="button"
        class:list={[pill, 'tr-save border border-line bg-white']}
        data-tr-save
        aria-pressed="false"
      >
        <Icon name="star" size={18} />
        {t(lang, 'translate.save')}
      </button>
    </div>
  </section>

  <section class="mt-4 space-y-3" data-tr-menu hidden aria-live="polite">
    <h3 class="m-0 text-[16px] font-bold">{t(lang, 'translate.menuTitle')}</h3>
    <p class="m-0 flex gap-1.5 rounded-2xl bg-sand/70 p-3 text-[13px]" data-tr-menu-tip></p>
    <p class="m-0 text-[14px] text-ink-muted" data-tr-menu-empty hidden>
      {t(lang, 'translate.menuEmpty')}
    </p>
    <ul class="m-0 list-none space-y-2 p-0" data-tr-menu-list></ul>
    <p class="m-0 text-[11px] text-ink-muted">{t(lang, 'translate.menuNote')}</p>
  </section>

  <section class="mt-5" data-tr-saved hidden>
    <h3 class="m-0 mb-2 flex items-center gap-1.5 text-[15px] font-bold">
      <Icon name="star" size={16} class="text-amber" />
      {t(lang, 'translate.savedTitle')}
    </h3>
    <ul class="m-0 list-none space-y-2 p-0" data-tr-saved-list></ul>
  </section>

  <p class="mt-4 text-[11px] leading-relaxed text-ink-muted">
    {t(lang, 'translate.privacy')}
    <a href={localizePath('/phrases/', lang)}>{t(lang, 'translate.phrasebookLink')}</a>
  </p>

  <template data-tr-menu-item>
    <li class="rounded-2xl border border-line bg-white/80 p-3">
      <div class="flex items-start gap-2">
        <div class="min-w-0 flex-1">
          <p class="m-0 flex flex-wrap items-center gap-1.5 text-[16px] leading-snug font-bold">
            <span data-m-ja></span>
            <span class="tag tag--amber" data-m-pick hidden>
              ★ {t(lang, 'translate.pick')}
            </span>
          </p>
          <p class="font-latin m-0 text-[14px] font-semibold" lang="vi" data-m-vi></p>
          <p class="m-0 text-[12px] text-river" data-m-kana></p>
          <p class="m-0 mt-1 text-[13px] leading-relaxed text-ink-muted" data-m-desc></p>
          <p class="m-0 mt-1 text-[13px] font-bold" data-m-price></p>
        </div>
        <button
          type="button"
          class="glass-press touch-target shrink-0 rounded-full bg-amber px-3 text-[13px] font-bold text-ink-dark"
          data-m-order
        >
          {t(lang, 'translate.orderThis')}
        </button>
      </div>
    </li>
  </template>

  <template data-tr-saved-item>
    <li class="flex items-center gap-2 rounded-2xl bg-sand/70 p-2 pl-3">
      <button type="button" class="glass-press min-h-[44px] min-w-0 flex-1 text-left" data-s-open>
        <span class="font-latin block truncate text-[15px] font-bold" data-s-main></span>
        <span class="block truncate text-[12px] text-ink-muted" data-s-sub></span>
      </button>
      <button
        type="button"
        class="glass-press touch-target grid shrink-0 place-items-center rounded-full text-ink-muted"
        data-s-remove
        aria-label={t(lang, 'translate.remove')}
      >
        <Icon name="close" size={18} />
      </button>
    </li>
  </template>
</GlassSheet>

<script
  type="application/json"
  data-tr-messages
  is:inline
  set:html={JSON.stringify({
    offline: t(lang, 'translate.errOffline'),
    unavailable: t(lang, 'translate.errUnavailable'),
    busy: t(lang, 'translate.errBusy'),
    failed: t(lang, 'translate.errFailed'),
    micDenied: t(lang, 'translate.errMic'),
    badImage: t(lang, 'translate.errImage'),
  })}
/>
<script>
  import { initTranslate } from './client';

  const sheet = document.getElementById('translate-sheet');
  if (sheet) initTranslate(sheet);
</script>

<style>
  .translate-fab {
    position: fixed;
    z-index: 39; /* below the tab bar (40) and every dialog */
    right: var(--spacing-gutter);
    bottom: calc(var(--tabbar-h) + var(--tabbar-gap) * 2 + var(--safe-bottom));
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    color: var(--color-ink-dark);
    background: var(--color-amber);
    box-shadow:
      inset 0 1px 0.5px rgb(255 255 255 / 0.6),
      0 10px 24px -8px rgb(120 50 0 / 0.55);
  }
  .tr-dir {
    min-height: 44px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  .tr-dir[aria-pressed='true'] {
    background: #fff;
    color: var(--color-amber);
    box-shadow: 0 2px 8px -4px rgb(20 28 46 / 0.3);
  }
  .tr-mic {
    color: var(--color-river);
    background: color-mix(in srgb, var(--color-river) 10%, white);
  }
  /* listening: pulsing red ring */
  .tr-mic[aria-pressed='true'] {
    color: #fff;
    background: #d6334a;
    animation: tr-pulse 1.2s ease-out infinite;
  }
  @keyframes tr-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(214 51 74 / 0.5);
    }
    100% {
      box-shadow: 0 0 0 14px rgb(214 51 74 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-mic[aria-pressed='true'] {
      animation: none;
    }
  }
  .tr-save[aria-pressed='true'] {
    color: var(--color-amber);
    border-color: var(--color-amber);
  }
  .tr-save[aria-pressed='true'] :global(svg path) {
    fill: currentColor;
  }
</style>
