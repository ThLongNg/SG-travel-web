---
// 404 (owner: Agent A) — one file, Japanese (static hosts serve a single 404.html).
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/glass/GlassPanel.astro';
import GlassButton from '../components/glass/GlassButton.astro';
import { t } from '../lib/i18n';

const lang = 'ja' as const;
---

<BaseLayout title={t(lang, 'notFound.title')} lang={lang} noindex>
  <div class="mx-auto flex min-h-[60dvh] max-w-xl flex-col justify-center px-4">
    <GlassPanel variant="strong" padding="lg" class="overflow-hidden text-center">
      <div class="tile-pattern pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <p
        class="font-latin m-0 text-[88px] leading-none font-extralight tracking-[0.12em] text-amber"
        aria-hidden="true"
      >
        404
      </p>
      <p class="font-latin mt-2 text-[12px] tracking-[0.35em] text-ink-muted" lang="vi">
        {t(lang, 'site.decorVi').toUpperCase()}
      </p>
      <h1 class="mt-4 text-[24px]">{t(lang, 'notFound.title')}</h1>
      <p class="mt-2 text-[15px] text-ink-muted">{t(lang, 'notFound.lead')}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <GlassButton href="/" variant="accent" icon="home">
          {t(lang, 'notFound.backHome')}
        </GlassButton>
        <GlassButton href="/spots/" icon="pin">
          {t(lang, 'spots.title')}
        </GlassButton>
      </div>
    </GlassPanel>
  </div>
</BaseLayout>
