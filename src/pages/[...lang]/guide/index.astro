---
// 旅の準備・お役立ち: VND⇄JPY converter + short collapsible guide cards.
// Food & souvenir cards live on their own page (/eat/); this page links to it.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlassPanel from '../../../components/glass/GlassPanel.astro';
import Icon from '../../../components/glass/Icon.astro';
import CurrencyConverter from '../../../components/tools/CurrencyConverter.astro';
import GuideCards from '../../../components/guide/GuideCards.astro';
import { EAT_CATEGORIES } from '../../../components/guide/categories';
import { getLocale, localeParams, localizePath, t } from '../../../lib/i18n';

export const getStaticPaths = localeParams;
const lang = getLocale(Astro.params.lang);

const guides = (await getCollection('guides'))
  .filter((g) => !EAT_CATEGORIES.includes(g.data.category))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={t(lang, 'guide.title')} lang={lang} activeTab="guide">
  <div class="mx-auto max-w-5xl space-y-12 px-4">
    <header>
      <p class="eyebrow font-latin tracking-[0.3em]!">TRAVEL GUIDE</p>
      <h1 class="mt-1 text-[28px] leading-snug">{t(lang, 'guide.title')}</h1>
      {lang !== 'ja' && (
        <p class="mt-2 text-[12px] text-ink-muted">{t(lang, 'common.untranslated')}</p>
      )}
    </header>

    <section aria-labelledby="g-rate" id="converter" class="scroll-mt-28">
      <div class="section-head">
        <h2 id="g-rate">
          <span class="section-no">01</span>
          {t(lang, 'guide.converterTitle')}
        </h2>
      </div>
      <CurrencyConverter lang={lang} />
    </section>

    <GlassPanel as="aside" variant="light" padding="none">
      <a
        href={localizePath('/eat/', lang)}
        class="flex min-h-[64px] items-center gap-3 p-4 no-underline"
      >
        <span class="icon-badge icon-badge--amber">
          <Icon name="bowl" size={20} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[17px] font-bold">{t(lang, 'eat.title')}</span>
          <span class="block text-[13px] text-ink-muted">{t(lang, 'eat.lead')}</span>
        </span>
        <Icon name="chevronRight" class="shrink-0 text-ink-muted" />
      </a>
    </GlassPanel>

    <section aria-labelledby="g-basics">
      <div class="section-head">
        <h2 id="g-basics">
          <span class="section-no">02</span>
          {t(lang, 'guide.categories')}
        </h2>
      </div>
      <GuideCards lang={lang} guides={guides} />
    </section>
  </div>
</BaseLayout>
