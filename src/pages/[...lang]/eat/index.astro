---
// 食べる・買う: must-try dishes as "shop sign" cards (tap for how to eat + order phrases) and
// souvenirs (Japanese/Vietnamese names to show the staff). No specific restaurants or stores.
// Data: src/data/eat/{dishes,souvenirs}.yml · tips: guides collection (food / shopping).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroPhoto from '../../../assets/eat/bun-rieu.webp';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlassChip from '../../../components/glass/GlassChip.astro';
import Icon from '../../../components/glass/Icon.astro';
import GuideCards from '../../../components/guide/GuideCards.astro';
import DishCard from '../../../components/eat/DishCard.astro';
import SouvenirCard from '../../../components/eat/SouvenirCard.astro';
import { getLocale, localeParams, localizePath, t, type I18nKey } from '../../../lib/i18n';

export const getStaticPaths = localeParams;
const lang = getLocale(Astro.params.lang);

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const dishes = (await getCollection('dishes')).sort(byOrder);
const souvenirs = (await getCollection('souvenirs')).sort(byOrder);
const guides = (await getCollection('guides')).sort(byOrder);
const foodTips = guides.filter((g) => g.data.category === 'food');
const shopTips = guides.filter((g) => g.data.category === 'shopping');

const shopCount = new Set(dishes.flatMap((d) => d.data.shops.map((s) => s.name))).size;
const bibCount = new Set(
  dishes.flatMap((d) => d.data.shops.filter((s) => s.michelin === 'bib').map((s) => s.name)),
).size;

const dishCats: [string, I18nKey][] = [
  ['main', 'eat.catMain'],
  ['snack', 'eat.catSnack'],
  ['sweet', 'eat.catSweet'],
  ['drink', 'eat.catDrink'],
];
const souvCats: [string, I18nKey][] = [
  ['food', 'eat.sCatFood'],
  ['beauty', 'eat.sCatBeauty'],
  ['craft', 'eat.sCatCraft'],
  ['fashion', 'eat.sCatFashion'],
];
---

<BaseLayout
  title={t(lang, 'eat.title')}
  description={t(lang, 'eat.lead')}
  lang={lang}
  activeTab="guide"
  breadcrumbs={[
    { name: t(lang, 'nav.home'), href: localizePath('/', lang) },
    { name: t(lang, 'eat.title'), href: localizePath('/eat/', lang) },
  ]}
>
  <div class="mx-auto max-w-5xl space-y-12 px-4">
    <header class="media-frame on-dark aspect-[4/5] rounded-[28px] sm:aspect-[16/7]">
      <Image
        src={heroPhoto}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 1024px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <span class="eat-hero__shade" aria-hidden="true"></span>
      <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-8">
        <p class="font-latin m-0 text-[12px] font-bold tracking-[0.3em] opacity-90">
          EAT &amp; SHOP
        </p>
        <h1 class="mt-1 text-[32px] leading-tight text-white sm:text-[40px]">
          {t(lang, 'eat.title')}
        </h1>
        <p class="mt-2 max-w-xl text-[15px] leading-relaxed opacity-95">{t(lang, 'eat.lead')}</p>
        <div class="mt-4 flex flex-wrap gap-2 text-[12px] font-bold">
          <span class="rounded-full bg-white/20 px-3 py-1.5 backdrop-blur">
            {t(lang, 'eat.statDishes').replace('{n}', String(dishes.length))}
          </span>
          <span class="rounded-full bg-white/20 px-3 py-1.5 backdrop-blur">
            {t(lang, 'eat.statShops').replace('{n}', String(shopCount))}
          </span>
          <span class="bib-badge">{t(lang, 'eat.statBib').replace('{n}', String(bibCount))}</span>
        </div>
      </div>
    </header>
    {lang !== 'ja' && (
      <p class="-mt-8 text-[12px] text-ink-muted">{t(lang, 'common.untranslated')}</p>
    )}

    <section aria-labelledby="eat-food" class="space-y-4" data-filter-scope>
      <div class="section-head mb-0!">
        <h2 id="eat-food">
          <span class="section-no">01</span>
          {t(lang, 'eat.eatTitle')}
        </h2>
      </div>
      <p class="m-0 text-[13px] text-ink-muted">{t(lang, 'eat.tapHint')}</p>
      <div class="h-scroll" role="group" aria-label={t(lang, 'eat.eatTitle')}>
        <GlassChip variant="light" selected data-cat="all">
          {t(lang, 'eat.all')}
        </GlassChip>
        {dishCats.map(([c, key]) => (
          <GlassChip variant="light" data-cat={c}>
            {t(lang, key)}
          </GlassChip>
        ))}
      </div>
      <ul class="m-0 grid list-none grid-cols-2 gap-x-3 gap-y-5 p-0 md:grid-cols-3 lg:grid-cols-4">
        {dishes.map((dish, i) => (
          <li data-item-cat={dish.data.category}>
            <DishCard lang={lang} dish={dish} eager={i < 2} />
          </li>
        ))}
      </ul>
      <p class="m-0 text-[12px] text-ink-muted">{t(lang, 'eat.priceNote')}</p>
      <GuideCards lang={lang} guides={foodTips} />
    </section>

    <section aria-labelledby="eat-shop" class="space-y-4" data-filter-scope>
      <div class="section-head mb-0!">
        <h2 id="eat-shop">
          <span class="section-no">02</span>
          {t(lang, 'eat.buyTitle')}
        </h2>
      </div>
      <div class="h-scroll" role="group" aria-label={t(lang, 'eat.buyTitle')}>
        <GlassChip variant="light" selected data-cat="all">
          {t(lang, 'eat.all')}
        </GlassChip>
        {souvCats.map(([c, key]) => (
          <GlassChip variant="light" data-cat={c}>
            {t(lang, key)}
          </GlassChip>
        ))}
      </div>
      <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 lg:grid-cols-3">
        {souvenirs.map((item) => (
          <li data-item-cat={item.data.category}>
            <SouvenirCard lang={lang} item={item} />
          </li>
        ))}
      </ul>
      <p class="m-0 text-[12px] text-ink-muted">{t(lang, 'eat.priceNote')}</p>
      <GuideCards lang={lang} guides={shopTips} />
    </section>

    <p
      class="glass glass--light glass-radius flex gap-2 p-3 text-[13px] text-ink-muted"
      data-no-voice
      hidden
      role="status"
    >
      <Icon name="alert" size={18} class="mt-0.5 shrink-0 text-amber" />
      {t(lang, 'phrases.noVoice')}
    </p>
  </div>
</BaseLayout>

<style>
  .eat-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 14 22 / 0.85),
      rgb(10 14 22 / 0.25) 55%,
      rgb(10 14 22 / 0.05)
    );
  }
</style>

<script>
  import { phraseTools } from '../../../components/phrase/client';

  // Category chips: show only the cards of the chosen category within the same section.
  for (const scope of document.querySelectorAll<HTMLElement>('[data-filter-scope]')) {
    const chips = [...scope.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const items = [...scope.querySelectorAll<HTMLElement>('[data-item-cat]')];
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.cat;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        for (const it of items) it.hidden = cat !== 'all' && it.dataset.itemCat !== cat;
      });
    }
  }

  // Speak / 見せる for every say-line (order phrases and souvenir names).
  const tools = phraseTools();
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const say = target.closest<HTMLElement>('[data-say]');
    if (!say || !tools) return;
    const { ja = '', vi = '', kana = '' } = say.dataset;
    if (target.closest('[data-show]')) tools.show(ja, vi, kana);
    else if (target.closest('[data-speak]')) tools.speak(vi);
  });
</script>
